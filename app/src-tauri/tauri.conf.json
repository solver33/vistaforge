{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vistaforge",
  "mainBinaryName": "Vistaforge",
  "version": "0.1.0",
  "identifier": "app.vistaforge.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vistaforge",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data: blob:",
        "style-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Conquest Reforged world generator",
    "longDescription": "Generates Minecraft 1.20.1 worlds built from Conquest Reforged blocks.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
